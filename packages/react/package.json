{
  "version": "0.1.42",
  "name": "dreamgrid",
  "type": "module",
  "description": "responsive image grid that respects aspect ratios",
  "author": "Phillip Jacowski",
  "license": "MIT",
  "homepage": "https://dreamgrid-rose.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/withintheruins14/dreamgrid"
  },
  "keywords": [
    "aspect ratio",
    "grid",
    "responsive",
    "ratio",
    "image",
    "masonry",
    "layout"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsup",
    "prepublishOnly": "cp ../../README.md ./README.md"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "@dreamgrid/utils": "workspace:*",
    "typescript": "latest",
    "typescript-config": "workspace:*"
  },
  "files": [
    "dist/**"
  ]
}
