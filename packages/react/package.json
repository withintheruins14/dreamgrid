{
  "version": "0.0.2",
  "name": "@dreamgrid/react",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsup src/index.ts src/use-grid.tsx --format cjs,esm && tsc --declaration --emitDeclarationOnly --outDir dist"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./use-grid": {
      "types": "./dist/use-grid.d.ts",
      "default": "./dist/use-grid.js"
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "typescript": "latest",
    "typescript-config": "workspace:*"
  },
  "dependencies": {
    "@dreamgrid/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist/**"
  ]
}