{
  "version": "0.0.2",
  "name": "@dreamgrid/utils",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsup src/index.ts src/get-item-size.ts src/make-next-row.ts src/row.ts src/make-rows.ts src/scale-dimension.ts src/factor-to-fit-in-minimum-row-height.ts src/width-at-minimum-row-height.ts --format cjs,esm && tsc --declaration --emitDeclarationOnly --outDir dist"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./get-item-size": {
      "types": "./dist/get-item-size.d.ts",
      "default": "./dist/get-item-size.js"
    },
    "./make-next-row": {
      "types": "./dist/make-next-row.d.ts",
      "default": "./dist/make-next-row.js"
    },
    "./row": {
      "types": "./dist/row.d.ts",
      "default": "./dist/row.js"
    },
    "./make-rows": {
      "types": "./dist/make-rows.d.ts",
      "default": "./dist/make-rows.js"
    },
    "./scale-dimension": {
      "types": "./dist/scale-dimension.d.ts",
      "default": "./dist/scale-dimension.js"
    },
    "./factor-to-fit-in-minimum-row-height": {
      "types": "./dist/factor-to-fit-in-minimum-row-height.d.ts",
      "default": "./dist/factor-to-fit-in-minimum-row-height.js"
    },
    "./width-at-minimum-row-height": {
      "types": "./dist/width-at-minimum-row-height.d.ts",
      "default": "./dist/width-at-minimum-row-height.js"
    }
  },
  "devDependencies": {
    "typescript": "latest",
    "typescript-config": "workspace:*"
  },
  "files": ["dist/**"]
}